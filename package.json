{
  "name": "game-news-api",
  "version": "1.0.0",
  "description": "Game News — service de notifications pour les actualités Steam",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint . --ext .js,.cjs,.mjs",
    "lint:ci": "eslint . --ext .js,.cjs,.mjs --max-warnings=0",
    "test": "cross-env NODE_ENV=test jest --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --forceExit --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --forceExit --coverage",
    "test:unit": "cross-env NODE_ENV=test jest --forceExit tests/unit",
    "test:integration": "cross-env NODE_ENV=test jest --forceExit tests/integration --runInBand",
    "test:ci": "cross-env NODE_ENV=test jest --forceExit --ci --coverage --runInBand",
    "build": "node -e \"console.log('No build step required')\""
  },
  "keywords": [
    "steam",
    "notifications",
    "api",
    "news"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.49.0",
    "agenda": "^5.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^13.6.0",
    "mongoose": "^8.12.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
