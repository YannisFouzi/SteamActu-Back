# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/steam-notifications?retryWrites=true&w=majority

# Steam API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key

# Server port
PORT=5000

# Environment (development | production | test)
NODE_ENV=development

# Mobile redirect scheme
MOBILE_REDIRECT_SCHEME=steamnotif

# Allowed origins for CORS (comma separated, "*" for all)
CORS_ORIGINS=*

# Notification provider (simulation | onesignal | firebase)
NOTIFICATION_PROVIDER=simulation

# OneSignal configuration (required when provider=onesignal)
# ONESIGNAL_APP_ID=your_onesignal_app_id
# ONESIGNAL_API_KEY=your_onesignal_api_key
