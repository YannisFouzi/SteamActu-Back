# ============================================================================
#  Game News — backend env vars
#  Required vars cause process.exit(1) at boot if missing.
#  Tous les autres ont un default raisonnable.
# ============================================================================

# ── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/steam-notifications?retryWrites=true&w=majority

# Steam API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key

# ── Server ──────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Allowed origins for CORS (comma separated, "*" for all)
# En prod, restreindre explicitement aux origines connues.
CORS_ORIGINS=*

# ── Mobile auth & session ───────────────────────────────────────────────────

# Scheme deep link de l'app mobile (recoit le callback OpenID)
MOBILE_REDIRECT_SCHEME=steamnotif

# HMAC secret pour signer les tokens de session mobile (64 chars hex recommande)
# Genere : openssl rand -hex 32
# Fallback chain: ADMIN_SESSION_SECRET → API_AUTH_KEY → STEAM_API_KEY
# IMPORTANT : configurer explicitement en prod, ne pas s'appuyer sur le fallback.
MOBILE_SESSION_SECRET=your_64_char_hex_secret

# Duree de vie des sessions mobiles (default 30 jours)
MOBILE_SESSION_TTL_DAYS=30

# Steam IDs autorises a acceder a /api/admin/stats depuis l'app mobile
# (separes par virgule). Vide = personne.
ADMIN_STEAM_IDS=

# ── Admin dashboard /admin (UI web + Bearer API) ────────────────────────────

# Bearer token pour curl/scripts (64 chars hex recommande)
# Genere : openssl rand -hex 32
ADMIN_TOKEN=

# Bcrypt hash du mot de passe UI admin (cost 12)
# Genere : node scripts/generate-admin-password.js <password>
ADMIN_PASSWORD_HASH=

# HMAC secret pour signer le cookie de session du dashboard (64 chars hex)
# Genere : openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ── Notifications push ──────────────────────────────────────────────────────

# Provider : simulation (dev) | firebase (prod)
NOTIFICATION_PROVIDER=simulation

# Chemin absolu vers le JSON de credentials Firebase (requis si firebase)
# Le fichier doit etre gitignore.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Icones SteamGridDB (optionnel) ──────────────────────────────────────────

# Cle API SteamGridDB pour enrichir les icones de jeux (haute qualite)
# Sans cette cle, fallback sur les icones officielles Steam (basse qualite).
STEAMGRIDDB_API_KEY=

# ── Feedback emails (POST /api/feedback) ────────────────────────────────────

RESEND_API_KEY=
FEEDBACK_TO_EMAIL=contact@fouzi-dev.fr
# FEEDBACK_FROM_EMAIL="Game News <noreply@fouzi-dev.fr>"

# ── Monitoring (Sentry) ─────────────────────────────────────────────────────

# DSN Sentry. Vide = Sentry desactive, l'app tourne normalement.
SENTRY_DSN=

# Sampling traces (0.0 a 1.0). Default 0.1 (10% des requetes).
SENTRY_TRACES_SAMPLE_RATE=0.1

# Release tracking (ex: git SHA court ou tag de version)
# SENTRY_RELEASE=v1.0.0

# ── MongoDB tuning (avance) ─────────────────────────────────────────────────

# Timeouts en ms
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# IP family : 4 = IPv4 only (default, evite ECONNREFUSED IPv6 local)
#             6 = IPv6 only
#             0 = both (recommande sur infra moderne)
MONGODB_FAMILY=4

# Override DNS Node (c-ares) — utile en dev quand le resolver local refuse
# les requetes SRV mongodb+srv. Format : "1.1.1.1,8.8.8.8".
# BACKEND_DNS_SERVERS=
